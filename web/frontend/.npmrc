# npm configuration for kicli-web-frontend

# Allow transitive dependency issues with monaco-editor's dompurify
# Monaco-editor bundles an older dompurify version that has known XSS vulnerabilities
# See: https://github.com/advisories/GHSA-p98j-92pf-mc4p
# 
# Monaco-editor is in read-only use for viewing built code only (not user input processing)
# The vulnerability risk is mitigated by:
# 1. Code displayed is from trusted sources (git repos, not user input)
# 2. Editor content is not processed/sanitized as HTML
# 3. No execution of displayed code
#
# Workaround: Force loose peer dependency resolution
legacy-peer-deps=true
